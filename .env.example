DATABASE_URL=postgresql+asyncpg://rag:rag@localhost:5432/rag
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIM=1024
CHUNK_SIZE=500
CHUNK_OVERLAP=50
API_KEY=change-me
# MCP 서버 인증 토큰 (빈 값 = 무인증 로컬 개발 모드, 사내 배포 시 필수)
MCP_BEARER_TOKEN=
# OpenAI 호환 LLM 서버 (Ollama 기본값, 사내 서버 정해지면 교체)
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=mistral
# arq 인제스트 워커 큐 (API와 워커가 같은 redis를 사용)
REDIS_URL=redis://localhost:6379
MAX_UPLOAD_MB=50
# MCP 서버가 외부에 알리는 자기 주소 (사내 배포 시 실제 호스트로)
MCP_PUBLIC_URL=http://localhost:8001
# 검색 후보 수 (벡터/키워드가 각각 이만큼 뽑고, 융합·재정렬을 거쳐 top_k만 남는다)
CANDIDATE_K=30
# 하이브리드 검색: 벡터 + 트라이그램 키워드를 RRF로 융합. pg_trgm 확장이 필요하므로
# alembic upgrade head를 먼저 돌릴 것
HYBRID_ENABLED=true
# 키워드 매칭 최소 유사도(0~1). pg_trgm 기본값 0.6은 질의가 길어지면 아무것도 못 잡는다
KEYWORD_THRESHOLD=0.3
# 리랭커(cross-encoder). true면 검색 정확도가 오르는 대신 모델 약 2.2GB가 추가로 내려받아지고
# 검색 지연이 늘어난다
RERANK_ENABLED=false
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
